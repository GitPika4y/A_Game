<Page x:Class="A_Game.Pages.StartMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:A_Game.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.4*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="A GAME"
            FontSize="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            />

        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Orientation="Vertical"
                        Margin="0 10"
                        >
                <Button
                    x:Name="btnContinue"
                    Content="Продолжить"
                    Visibility="Collapsed"
                    Padding="15 5"
                    Click="btnClick_Continue"
                    />
                <TextBlock
                    x:Name="txblock_SaveDate"
                    Visibility="Collapsed"
                    Margin="15 0 0 0"
                    />
            </StackPanel>

            <Button
                Content="Начать игру"
                Padding="15 5" Click="btnClick_StartGame"
                />

            <Button
                Content="Выйти"
                Padding="15 5" Click="btnClick_ShutDown"
                />
        </StackPanel>
    </Grid>
</Page>
